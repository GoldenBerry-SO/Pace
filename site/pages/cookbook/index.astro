---
import Base from '../../layouts/Base.astro';

interface TeamCard {
  slug: string;
  name: string;
  hook: string;
  recipeCount: number;
  marquee: string;
}

const teams: TeamCard[] = [
  {
    slug: 'sales',
    name: 'Sales',
    hook: 'Pipeline brief on Monday. Account-prep when a meeting hits the calendar. Follow-ups drafted from the call transcript.',
    recipeCount: 3,
    marquee: 'Monday morning pipeline brief, in your inbox by 7am',
  },
  {
    slug: 'marketing',
    name: 'Marketing',
    hook: "Weekly campaign brief. Content drafting that knows your brand voice. Performance reports you don't have to assemble.",
    recipeCount: 3,
    marquee: 'Weekly campaign performance digest, Fridays at 4pm',
  },
  {
    slug: 'engineering',
    name: 'Engineering',
    hook: 'A disciplined stacked-PR workflow plus careful-review, TDD, diagnose, security-review, and the rest of the 34-skill toolkit.',
    recipeCount: 8,
    marquee: 'The stacked-PR way of working',
  },
  {
    slug: 'data',
    name: 'Data',
    hook: 'Weekday anomaly digest. Query writing against your warehouse. Dashboards that explain themselves.',
    recipeCount: 3,
    marquee: 'Weekly metric anomaly digest, Mondays at 7am',
  },
  {
    slug: 'product',
    name: 'Product',
    hook: 'Customer feedback synthesis. Roadmap planning from your Linear backlog. Specs that hand off cleanly to engineering.',
    recipeCount: 3,
    marquee: 'User-interview synthesis at the end of every research sprint',
  },
  {
    slug: 'finance',
    name: 'Finance',
    hook: 'Month-end runbook. Variance analysis the CFO wants before they ask. Audit prep that runs itself.',
    recipeCount: 3,
    marquee: 'Month-end runbook, automated',
  },
  {
    slug: 'legal',
    name: 'Legal',
    hook: 'NDA redlines in five minutes. Contract review with the unusual clauses flagged. Compliance audit prep on schedule.',
    recipeCount: 3,
    marquee: 'NDA triage queue',
  },
  {
    slug: 'operations',
    name: 'Operations',
    hook: 'Vendor renewal heads-up 60 days out. Recurring-meeting documentation. Capacity planning grounded in real usage.',
    recipeCount: 3,
    marquee: 'Weekly cross-team status digest',
  },
  {
    slug: 'people',
    name: 'People',
    hook: 'Job descriptions in your voice. Onboarding plans for new hires. 360 reviews consolidated into something coherent.',
    recipeCount: 2,
    marquee: 'Weekly recruiting pipeline digest',
  },
  {
    slug: 'customer-support',
    name: 'Customer Support',
    hook: 'Weekend on-call digest. Knowledge-base articles from real resolved tickets. Ticket triage that catches the urgent ones.',
    recipeCount: 3,
    marquee: 'Real-time ticket triage with macro suggestion',
  },
  {
    slug: 'productivity',
    name: 'Productivity',
    hook: 'Morning brief from your calendar + Slack + Linear. End-of-week recap. Project memory that does not forget what you decided.',
    recipeCount: 3,
    marquee: 'Daily update that pulls itself together',
  },
  {
    slug: 'design',
    name: 'Design',
    hook: 'Brand-voice enforcement on landing pages. Visual checks before deploy. Defers to impeccable for frontend code-level craft.',
    recipeCount: 3,
    marquee: 'Per-PR design audit before review',
  },
];
---

<Base
  title="Cookbook · Pace"
  description="Concrete recipes for every team. Sales prep on Monday morning. Marketing reports on Friday afternoon. Engineering's stacked-PR workflow. Pick the team you're on."
  activeNav="cookbook"
  canonicalPath="/cookbook"
>
  <article class="ck-page">
    <header class="ck-header">
      <span class="ck-eyebrow">Cookbook</span>
      <h1 class="ck-title">Recipes, not theory.</h1>
      <p class="ck-lede">
        Each recipe combines Pace skills with Claude Code features (<a href="https://code.claude.com/docs/en/routines">Routines</a>, <a href="https://code.claude.com/docs/en/hooks">hooks</a>, <a href="https://code.claude.com/docs/en/sub-agents">sub-agents</a>, plan mode, <a href="https://code.claude.com/docs/en/mcp">MCP connectors</a>) and walks you through setup. Pick the team you're on.
      </p>
    </header>

    <section class="ck-grid">
      {teams.map((t) => (
        <a class="ck-card" href={`/cookbook/${t.slug}`}>
          <div class="ck-card-head">
            <span class="ck-card-name">{t.name}</span>
            <span class="ck-card-count">{t.recipeCount} {t.recipeCount === 1 ? 'recipe' : 'recipes'}</span>
          </div>
          <p class="ck-card-hook">{t.hook}</p>
          <div class="ck-card-marquee">
            <span class="ck-card-marquee-label">Marquee recipe</span>
            <p>{t.marquee}</p>
          </div>
          <span class="ck-card-cta">Open the {t.name.toLowerCase()} cookbook &nearr;</span>
        </a>
      ))}
    </section>

    <footer class="ck-footer">
      <p>
        Have a workflow that should live here? <a href="https://github.com/GoldenBerry-SO/Pace/issues/new">Open an issue</a> with the trigger, skills, and Claude features it uses; we'll fold it into the cookbook.
      </p>
    </footer>
  </article>
</Base>

<style is:global>
  .ck-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-3xl);
  }
  .ck-header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-mist);
  }
  .ck-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ash);
    padding: 5px 10px;
    border: 1px solid var(--color-mist);
    border-radius: 4px;
    background: var(--color-paper-elev);
    margin-bottom: var(--spacing-md);
  }
  .ck-eyebrow::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: currentColor;
  }
  .ck-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin-bottom: var(--spacing-md);
  }
  .ck-lede {
    font-size: var(--fs-md);
    line-height: 1.65;
    color: var(--color-charcoal);
    max-width: 70ch;
    margin: 0 auto;
  }

  /* Team grid */
  .ck-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-2xl);
  }
  .ck-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: var(--spacing-lg);
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-fast) var(--ease-out-quart),
                background var(--duration-fast) var(--ease-out-quart),
                transform var(--duration-fast) var(--ease-out-quart);
  }
  .ck-card:hover {
    border-color: var(--color-forest);
    background: color-mix(in oklch, var(--color-paper-elev) 92%, var(--color-forest-dim));
    transform: translateY(-2px);
  }
  .ck-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .ck-card-name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .ck-card-count {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ash);
  }
  .ck-card-hook {
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--color-charcoal);
    margin: 0;
  }
  .ck-card-marquee {
    background: var(--color-paper);
    border: 1px solid var(--color-mist);
    border-radius: 8px;
    padding: 10px 14px;
    margin-top: 4px;
  }
  .ck-card-marquee-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-forest);
    margin-bottom: 4px;
  }
  .ck-card-marquee p {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.45;
    color: var(--color-ink);
    font-weight: 500;
  }
  .ck-card-cta {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-forest);
    font-weight: 600;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px dashed var(--color-mist);
  }

  .ck-footer {
    text-align: center;
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--color-mist);
  }
  .ck-footer p {
    font-size: var(--fs-sm);
    color: var(--color-ash);
    line-height: 1.6;
  }
  .ck-footer a {
    color: var(--color-forest);
    border-bottom: 1px solid var(--color-forest-soft);
  }

  @media (max-width: 720px) {
    .ck-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
