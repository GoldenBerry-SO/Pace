<style>
  /* ============================================
     HERO
     ============================================ */
  /* ============================================
     HERO, single-column centered with horizon glow
     ============================================ */
  .hero {
    position: relative;
    min-height: 78vh;
    padding: 120px var(--spacing-lg) 64px;
    margin: 0;
    max-width: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
  }
  /* Soft horizon glow tuned for cream/light theme:
     a subtle pastel-clay band that frames the type
     instead of washing over it. */
  .hero-glow {
    position: absolute;
    inset: -10% 0 0 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(45% 30% at 82% 65%, oklch(78% 0.11 32 / 0.32) 0%, transparent 75%),
      radial-gradient(35% 24% at 18% 60%, oklch(82% 0.07 145 / 0.32) 0%, transparent 78%);
    filter: blur(45px);
    animation: hero-drift 26s ease-in-out infinite alternate;
  }
  @keyframes hero-drift {
    0%   { transform: translate3d(0%, 0%, 0) scale(1); opacity: 0.85; }
    50%  { transform: translate3d(3%, -1%, 0) scale(1.05); opacity: 1; }
    100% { transform: translate3d(-2%, 1%, 0) scale(1.02); opacity: 0.92; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-glow { animation: none; }
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
    max-width: 920px;
    width: 100%;
  }
  .hero-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(96px, 12vw, 144px);
    height: clamp(64px, 8vw, 96px);
    color: var(--color-ink);
    margin-bottom: 8px;
  }
  .hero-mark svg {
    width: 100%;
    height: 100%;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 11vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: 600;
    color: var(--color-ink);
  }
  .hero-supertitle {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    line-height: 1.25;
    color: var(--color-charcoal);
    max-width: 30ch;
    margin: 0 auto;
    letter-spacing: -0.01em;
  }
  .hero-subtitle {
    font-size: clamp(1rem, 1.4vw, 1.0625rem);
    line-height: 1.6;
    color: var(--color-ash);
    max-width: 60ch;
    margin: 0 auto;
  }
  .hero-tagline,
  .hero-lede {
    display: none;
  }
  .hero-link {
    color: var(--color-forest);
    border-bottom: 1px solid var(--color-forest-soft);
    transition: border-color var(--duration-fast) var(--ease-out-quart);
  }
  .hero-link:hover {
    border-color: var(--color-forest);
  }
  .hero-included {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 8px;
    margin-bottom: var(--spacing-lg);
    max-width: 52ch;
    font-size: var(--fs-sm);
  }
  .hero-included-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ash);
  }
  .hero-included-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    align-items: center;
    color: var(--color-charcoal);
  }
  .hero-included em {
    font-style: normal;
    color: var(--color-ink);
    font-weight: 600;
  }
  .hero-sep {
    color: var(--color-ash);
  }
  .hero-cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--spacing-xs);
  }
  /* Hero proof strip: faint partner-logo style row */
  .hero-proof {
    position: relative;
    z-index: 1;
    margin-top: var(--spacing-3xl);
    padding-top: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    border-top: 1px solid var(--color-mist);
    max-width: 920px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
  }
  .hero-proof-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ash);
  }
  .hero-proof-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .hero-proof-list li {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--color-ash);
    transition: color var(--duration-base) var(--ease-out-quart);
  }
  .hero-proof-list li:hover {
    color: var(--color-charcoal);
  }

  /* ============================================
     INSTALL PATHS, two-up cards below the hero
     ============================================ */
  .install-paths {
    max-width: var(--width-max);
    margin: 0 auto;
    padding: var(--spacing-2xl) var(--spacing-lg);
    border-top: none;
  }
  .install-paths-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
  }
  .install-card {
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 12px;
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-fast) var(--ease-out-quart),
                background var(--duration-fast) var(--ease-out-quart),
                transform var(--duration-fast) var(--ease-out-quart);
  }
  a.install-card:hover {
    border-color: var(--color-forest);
    background: color-mix(in oklch, var(--color-paper-elev) 88%, var(--color-forest-dim));
    transform: translateY(-2px);
  }
  .install-card-cowork {
    border-color: var(--color-forest);
    background: color-mix(in oklch, var(--color-paper-elev) 88%, var(--color-forest-dim));
  }
  a.install-card-cowork:hover {
    background: color-mix(in oklch, var(--color-paper-elev) 78%, var(--color-forest-dim));
  }
  .install-card-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-forest);
  }
  .install-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin: 0;
  }
  .install-card p {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.55;
  }
  .install-terminal {
    border-radius: 8px;
    overflow: hidden;
    margin-top: var(--spacing-xs);
  }
  .install-terminal .terminal-body {
    padding: var(--spacing-sm) var(--spacing-md);
    background: oklch(18% 0.015 150);
    color: oklch(92% 0.005 150);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.55;
    overflow-x: auto;
    margin: 0;
  }
  .install-card-cta {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-forest);
    font-weight: 600;
    text-decoration: none;
    margin-top: var(--spacing-xs);
  }
  .install-quicklinks {
    list-style: none;
    padding: 0;
    margin: 8px 0 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .install-quicklink {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--color-paper);
    border: 1px solid var(--color-mist);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-out-quart),
                background var(--duration-base) var(--ease-out-quart),
                color var(--duration-base) var(--ease-out-quart);
  }
  .install-quicklink:hover {
    border-color: var(--color-forest);
    background: var(--color-forest);
    color: var(--color-paper);
  }
  .install-quicklink span:last-child {
    color: var(--color-forest);
    font-size: 11px;
    transition: color var(--duration-base) var(--ease-out-quart);
  }
  .install-quicklink:hover span:last-child {
    color: var(--color-paper);
  }
  @media (max-width: 720px) {
    .install-paths-inner {
      grid-template-columns: 1fr;
    }
    .install-quicklinks {
      grid-template-columns: 1fr;
    }
  }
  a.hero-install-card-cta:hover {
    text-decoration: underline;
  }

  /* ============================================
     ROLES (Who's it for)
     ============================================ */
  .roles {
    max-width: var(--width-max);
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-xl);
  }
  .roles-inner {
    max-width: var(--width-content);
    margin: 0 auto;
  }
  .roles-head {
    margin-bottom: var(--spacing-xl);
    text-align: center;
  }
  .roles-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-forest);
    margin-bottom: var(--spacing-sm);
    display: inline-block;
  }
  .roles-title {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin-bottom: var(--spacing-md);
  }
  .roles-lede {
    font-size: var(--fs-base);
    color: var(--color-charcoal);
    line-height: 1.55;
    max-width: 56ch;
    margin: 0 auto;
  }
  .roles-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-sm);
  }
  @media (max-width: 880px) {
    .roles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .roles-grid {
      grid-template-columns: 1fr;
    }
  }
  .role-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color var(--duration-fast) var(--ease-out-quart),
                background var(--duration-fast) var(--ease-out-quart),
                transform var(--duration-fast) var(--ease-out-quart);
  }
  .role-card:hover {
    border-color: var(--color-forest);
    background: color-mix(in oklch, var(--color-paper-elev) 84%, var(--color-forest-dim));
    transform: translateY(-1px);
  }
  .role-card-name {
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }
  .role-card-blurb {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.45;
  }
  .roles-footnote {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-mist);
    text-align: center;
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.6;
  }
  .roles-footnote a {
    color: var(--color-forest);
    border-bottom: 1px solid var(--color-forest-soft);
  }

  /* ============================================
     CTA buttons, uppercase mono outlined
     ============================================ */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid var(--color-ink);
    transition: background var(--duration-base) var(--ease-out-quart),
                color var(--duration-base) var(--ease-out-quart),
                border-color var(--duration-base) var(--ease-out-quart);
  }
  .cta-primary {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .cta-primary:hover {
    background: var(--color-forest);
    border-color: var(--color-forest);
  }
  .cta-secondary {
    background: transparent;
    color: var(--color-ink);
  }
  .cta-secondary:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* ============================================
     Terminal
     ============================================ */
  .terminal {
    border-radius: 10px;
    overflow: hidden;
    background: oklch(18% 0.015 150);
    border: 1px solid oklch(28% 0.018 150);
  }
  .terminal-compact {
    margin: var(--spacing-sm) 0;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: oklch(22% 0.015 150);
    border-bottom: 1px solid oklch(28% 0.018 150);
  }
  .terminal-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .terminal-dot[data-dot='r'] { background: oklch(62% 0.18 25); }
  .terminal-dot[data-dot='y'] { background: oklch(78% 0.14 80); }
  .terminal-dot[data-dot='g'] { background: oklch(68% 0.14 150); }
  .terminal-label {
    margin-left: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: oklch(70% 0.01 150);
  }
  .terminal-body {
    padding: var(--spacing-md);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.5;
    color: oklch(92% 0.005 150);
    overflow-x: auto;
  }
  .terminal-body .prompt {
    color: var(--color-clay);
    margin-right: 8px;
  }
  .terminal-body .muted {
    color: oklch(60% 0.01 150);
    font-size: 0.82rem;
    display: block;
    margin: 4px 0 8px 0;
  }

  /* ============================================
     Section scaffolding
     ============================================ */
  .section {
    max-width: var(--width-max);
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg);
    border-top: 1px solid var(--color-mist);
  }
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--spacing-xl);
    text-align: center;
  }
  .section-number {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-forest);
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border: 1px solid var(--color-forest-soft);
    border-radius: 999px;
    background: var(--color-forest-dim);
  }
