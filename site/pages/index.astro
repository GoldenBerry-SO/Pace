---
import Base from '../layouts/Base.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Pace',
    url: 'https://pace.tools',
    logo: 'https://pace.tools/og-image.svg',
    description: 'AI specialists for every role at your company. Sales preps calls, engineers ship PRs, finance closes the month, marketing ships campaigns. Open source, Apache 2.0.',
    sameAs: ['https://github.com/GoldenBerry-SO/Pace'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Pace',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows',
    description: 'Pace gives every team at your company an AI specialist tuned to their work and connected to their real tools. 50 plugins across sales, marketing, engineering, data, product, finance, legal, ops, HR, customer support, and more. Connects through MCP to Slack, HubSpot, Snowflake, Notion, Linear, and dozens of others. Works with Cowork (desktop) and Claude Code (CLI). Apache 2.0, open source.',
    url: 'https://pace.tools',
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    softwareVersion: '0.2.0',
    aggregateRating: undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Pace',
    url: 'https://pace.tools',
    publisher: { '@type': 'Organization', name: 'GoldenBerry Software' },
  },
];
---

<Base
  title="Pace: AI specialists for every role at your company"
  description="Pace gives every team an AI specialist tuned to their work. Sales preps calls, engineers ship PRs, finance closes the month, marketing ships campaigns. Connects to your real tools (HubSpot, Slack, Snowflake, Notion, Linear) through MCP. Open source, Apache 2.0."
  activeNav="home"
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <!-- ============================================
