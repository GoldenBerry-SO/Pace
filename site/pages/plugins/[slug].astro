---
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import SubPage from '../../layouts/SubPage.astro';
import marketplace from '../../../.claude-plugin/marketplace.json';
import {
  enumeratePlugins,
  type PluginDetail,
  type Skill,
  type ConnectorEntry,
  type PluginEntry,
} from '../../lib/plugin-details';
import {
  PLUGIN_CATEGORIES,
  PLUGIN_CATEGORY_LABELS,
  PLUGIN_CATEGORY_ORDER,
} from '../../lib/sidebar-data';
import { CONNECTOR_CATEGORIES } from '../../lib/connector-data';

export async function getStaticPaths() {
  // Re-import inside getStaticPaths so the prerender chunk can find them.
  const { enumeratePlugins } = await import('../../lib/plugin-details');
  const fs = await import('node:fs');
  const path = await import('node:path');
  const { fileURLToPath } = await import('node:url');
  const marketplace = (await import('../../../.claude-plugin/marketplace.json', { with: { type: 'json' } })).default;

  const __dirname = path.dirname(fileURLToPath(import.meta.url));
  const repoRoot = path.resolve(__dirname, '../../../');
  const plugins = (marketplace.plugins ?? []) as PluginEntry[];

  return enumeratePlugins(repoRoot, plugins).map(({ slug, detail }) => ({
    params: { slug },
    props: detail,
  }));
}

interface Props {
  slug: string;
  manifest: PluginDetail['manifest'];
  displayName: string;
  marketplaceDescription: string;
  marketplaceAuthor: string;
  pluginDir: string;
  skills: Skill[];
  connectors: ConnectorEntry[];
  readmeExcerpt: string | null;
  hasConnectorsDoc: boolean;
  isPartner: boolean;
}

const {
  slug,
  manifest,
  displayName,
  marketplaceDescription,
  marketplaceAuthor,
  pluginDir,
  skills,
  connectors,
  readmeExcerpt,
  hasConnectorsDoc,
  isPartner,
} = Astro.props as Props;

const pluginName = manifest.name ?? slug;
const slashPrefix = `/${pluginName}:`;

// Categorized connector rows that include THIS plugin. Reuses the master
// catalog data from /docs/connectors so the structure is consistent.
const connectorCategories = CONNECTOR_CATEGORIES.filter((c) => c.usedBy.includes(slug));

// Build sidebar with all local plugins, grouped + sorted, same as
// the /plugins index sidebar. Mirrors impeccable's pattern of keeping
// nav state stable across the index and detail routes.
type SidebarPlugin = { slug: string };
const sidebarItems: Record<string, SidebarPlugin[]> = {};
for (const cat of PLUGIN_CATEGORY_ORDER) sidebarItems[cat] = [];
{
  type LocalEntry = { name: string; source?: string };
  const local = (marketplace.plugins ?? []).filter(
    (p): p is LocalEntry => typeof (p as LocalEntry).source === 'string' && (p as LocalEntry).source!.startsWith('./plugins/'),
  );
  for (const p of local) {
    const cat = PLUGIN_CATEGORIES[p.name] ?? 'specialized';
    sidebarItems[cat].push({ slug: p.name });
  }
  for (const cat of PLUGIN_CATEGORY_ORDER) {
    sidebarItems[cat].sort((a, b) => a.slug.localeCompare(b.slug));
  }
}
---


<SubPage
  title={`${displayName} · pace`}
  description={marketplaceDescription}
  activeNav="plugins"
  canonicalPath={`/plugins/${slug}`}
  sidebarLabel="Plugins"
>
  <Fragment slot="sidebar">
    <div class="subpage-sidebar-group">
      <span class="subpage-sidebar-group-title">All plugins</span>
      <ul class="subpage-sidebar-list">
        <li><a href="/plugins">Catalog</a></li>
      </ul>
    </div>
    {PLUGIN_CATEGORY_ORDER.map((cat) => (
      sidebarItems[cat].length > 0 && (
        <div class="subpage-sidebar-group">
          <span class="subpage-sidebar-group-title">{PLUGIN_CATEGORY_LABELS[cat]}</span>
          <ul class="subpage-sidebar-list">
            {sidebarItems[cat].map((item) => (
              <li><a href={`/plugins/${item.slug}`} aria-current={item.slug === slug ? 'page' : undefined}>{item.slug}</a></li>
            ))}
          </ul>
        </div>
      )
    ))}
  </Fragment>

  <article class="plugin-page">
    <header class="plugin-header">
      <div class="plugin-breadcrumb">
        <a href="/plugins">All plugins</a>
        <span>/</span>
        <span>{displayName}</span>
      </div>
      <div class="plugin-meta-row">
        <span class="plugin-slash"><code>{slashPrefix}*</code></span>
        {manifest.version && <span class="plugin-version">v{manifest.version}</span>}
        <span class="plugin-author">{marketplaceAuthor}</span>
        {isPartner && <span class="plugin-tag">Partner-built</span>}
      </div>
      <h1>{displayName}</h1>
      <p class="plugin-lede">{marketplaceDescription}</p>

      <div class="plugin-install">
        <span class="plugin-install-label">Install</span>
        <code>claude plugin install {pluginName}@pace.tools</code>
      </div>
    </header>

    {readmeExcerpt && (
      <section class="plugin-section plugin-readme">
        <h2>Overview</h2>
        <p>{readmeExcerpt}</p>
        <p class="plugin-readme-cta">
          <a href={`https://github.com/GoldenBerry-SO/pace.tools/tree/main/${pluginDir}`}>Read the full README on GitHub &rarr;</a>
        </p>
      </section>
    )}

    <section class="plugin-section">
      <h2>Skills ({skills.length})</h2>
      <p class="plugin-section-lede">
        Each skill auto-triggers when its description matches what you're doing, or you can invoke explicitly via the slash command.
      </p>
      <ul class="plugin-skills-list">
        {skills.map((s) => (
          <li class="plugin-skill">
            <div class="plugin-skill-head">
              <code class="plugin-skill-cmd">{slashPrefix}{s.name}</code>
            </div>
            <p class="plugin-skill-desc">{s.description || s.bodyPreview || '(no description)'}</p>
          </li>
        ))}
      </ul>
    </section>

    {connectorCategories.length > 0 && (
      <section class="plugin-section">
        <h2>Connectors</h2>
        <p class="plugin-section-lede">
          MCP servers this plugin integrates with, grouped by category. Bundled servers are pre-configured in <code>.mcp.json</code>. Alternatives slot in via <a href="/docs/connectors#placeholders">the <code>~~category</code> placeholder pattern</a>.
        </p>
        <div class="plugin-connectors-table" role="table">
          <div class="plugin-connectors-row plugin-connectors-row-head" role="row">
            <span role="columnheader">Category</span>
            <span role="columnheader">Bundled</span>
            <span role="columnheader">Alternatives</span>
          </div>
          {connectorCategories.map((c) => (
            <div class="plugin-connectors-row" role="row">
              <span class="plugin-connectors-cat" role="cell">
                <strong>{c.name}</strong>
                <code>{c.placeholder}</code>
              </span>
              <span class="plugin-connectors-bundled" role="cell">
                {c.bundled.length > 0
                  ? c.bundled.map((s) => <span class="plugin-connectors-pill">{s}</span>)
                  : <span class="plugin-connectors-empty">(none pre-configured)</span>
                }
              </span>
              <span class="plugin-connectors-alts" role="cell">
                {c.alternatives.length > 0
                  ? c.alternatives.join(', ')
                  : <span class="plugin-connectors-empty">none</span>
                }
              </span>
            </div>
          ))}
        </div>
        <p class="plugin-readme-cta">
          <a href="/docs/connectors">How MCP and connectors work &rarr;</a>
          {hasConnectorsDoc && <span class="plugin-connectors-sep"> · </span>}
          {hasConnectorsDoc && (
            <a href={`https://github.com/GoldenBerry-SO/pace.tools/blob/main/${pluginDir}/CONNECTORS.md`}>Full CONNECTORS.md on GitHub &rarr;</a>
          )}
        </p>
      </section>
    )}

    {connectorCategories.length === 0 && connectors.length > 0 && (
      <section class="plugin-section">
        <h2>Connectors</h2>
        <p class="plugin-section-lede">
          MCP servers this plugin can talk to. Claude prompts for authorization on first use.
          <a href="/docs/connectors"> How MCP and connectors work &rarr;</a>
        </p>
        <ul class="plugin-connectors">
          {connectors.map((c) => (
            <li class="plugin-connector">
              <span class="plugin-connector-name">{c.name}</span>
              {c.type && <span class="plugin-connector-type">{c.type}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="plugin-section">
      <h2>Source</h2>
      <ul class="plugin-source-list">
        <li><strong>Path:</strong> <code>{pluginDir}</code></li>
        <li><strong>Author:</strong> {marketplaceAuthor}</li>
        {manifest.version && <li><strong>Version:</strong> v{manifest.version}</li>}
        <li><strong>License:</strong> Apache 2.0</li>
        <li>
          <strong>Upstream:</strong>{' '}
          {isPartner ? (
            <span>Distributed via Anthropic's knowledge-work-plugins marketplace.</span>
          ) : (
            <a href={`https://github.com/anthropics/knowledge-work-plugins/tree/main/${pluginName}`}>
              anthropics/knowledge-work-plugins/{pluginName}
            </a>
          )}
        </li>
      </ul>
      <p class="plugin-source-note">
        Pace imports this plugin verbatim from upstream. We don't edit it here; customize by forking to a new directory (e.g. <code>plugins/{pluginName}-gb/</code>) and registering it separately in the marketplace.
      </p>
    </section>
  </article>
</SubPage>

<style>
  .plugin-page {
    max-width: 760px;
  }
  .plugin-header {
    margin-bottom: var(--spacing-2xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-mist);
  }
  .plugin-breadcrumb {
    display: flex;
    gap: var(--spacing-xs);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-ash);
    margin-bottom: var(--spacing-md);
  }
  .plugin-breadcrumb a {
    color: var(--color-forest);
    border-bottom: 1px solid var(--color-forest-soft);
  }
  .plugin-meta-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-md);
  }
  .plugin-slash code {
    font-family: var(--font-mono);
    font-size: var(--fs-md);
    color: var(--color-forest);
    background: var(--color-forest-dim);
    padding: 4px 12px;
    border-radius: 6px;
    border: 1px solid var(--color-forest-soft);
    font-weight: 500;
  }
  .plugin-version {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-ash);
    padding: 4px 10px;
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 999px;
  }
  .plugin-author {
    font-size: var(--fs-xs);
    color: var(--color-ash);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .plugin-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-clay-hover);
    padding: 2px 10px;
    background: var(--color-clay-dim);
    border: 1px solid var(--color-clay-soft);
    border-radius: 999px;
  }
  .plugin-header h1 {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    letter-spacing: -0.03em;
    margin-bottom: var(--spacing-md);
  }
  .plugin-lede {
    font-size: var(--fs-md);
    color: var(--color-charcoal);
    line-height: 1.55;
    margin-bottom: var(--spacing-lg);
    max-width: 64ch;
  }
  .plugin-install {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 8px;
  }
  .plugin-install-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ash);
  }
  .plugin-install code {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--color-ink);
  }
  .plugin-section {
    margin-bottom: var(--spacing-2xl);
  }
  .plugin-section h2 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-xs);
    border-bottom: 1px solid var(--color-mist);
  }
  .plugin-section-lede {
    font-size: var(--fs-base);
    color: var(--color-charcoal);
    line-height: 1.55;
    margin-bottom: var(--spacing-md);
    max-width: 64ch;
  }
  .plugin-readme {
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 10px;
    padding: var(--spacing-md);
  }
  .plugin-readme h2 {
    border-bottom: 0;
    padding-bottom: 0;
    margin-bottom: var(--spacing-xs);
    font-size: var(--fs-md);
  }
  .plugin-readme p {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.55;
  }
  .plugin-readme-cta {
    margin-top: var(--spacing-sm);
    font-size: var(--fs-sm);
  }
  .plugin-readme-cta a {
    color: var(--color-forest);
    border-bottom: 1px solid var(--color-forest-soft);
  }
  .plugin-skills-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--spacing-sm);
  }
  .plugin-skill {
    padding: var(--spacing-md);
    border: 1px solid var(--color-mist);
    border-radius: 8px;
    background: var(--color-paper-elev);
  }
  .plugin-skill-head {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }
  .plugin-skill-cmd {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-forest);
    background: transparent;
    border: 0;
    padding: 0;
    font-weight: 500;
  }
  .plugin-skill-desc {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.55;
  }
  .plugin-connectors {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }
  .plugin-connector {
    padding: 6px 12px;
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 999px;
    font-size: var(--fs-xs);
    color: var(--color-charcoal);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .plugin-connector-name {
    font-family: var(--font-mono);
    color: var(--color-ink);
    text-transform: lowercase;
  }
  .plugin-connector-type {
    font-family: var(--font-mono);
    color: var(--color-ash);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  /* Categorized connector table */
  .plugin-connectors-table {
    border: 1px solid var(--color-mist);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-paper-elev);
    margin-bottom: var(--spacing-sm);
  }
  .plugin-connectors-row {
    display: grid;
    grid-template-columns: 1.2fr 1.6fr 1.4fr;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
    border-bottom: 1px solid var(--color-mist);
    align-items: start;
    font-size: var(--fs-sm);
  }
  .plugin-connectors-row:last-child {
    border-bottom: 0;
  }
  .plugin-connectors-row-head {
    background: var(--color-paper);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ash);
    font-weight: 600;
  }
  .plugin-connectors-cat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .plugin-connectors-cat strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .plugin-connectors-cat code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--color-forest);
  }
  .plugin-connectors-bundled {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .plugin-connectors-pill {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 2px 8px;
    background: var(--color-forest-dim);
    color: var(--color-forest);
    border: 1px solid var(--color-forest-soft);
    border-radius: 999px;
  }
  .plugin-connectors-alts {
    color: var(--color-charcoal);
    line-height: 1.5;
    font-size: 0.85rem;
  }
  .plugin-connectors-empty {
    color: var(--color-ash);
    font-size: 0.85rem;
  }
  .plugin-connectors-sep {
    color: var(--color-ash);
  }
  @media (max-width: 760px) {
    .plugin-connectors-row {
      grid-template-columns: 1fr;
      gap: var(--spacing-xs);
    }
    .plugin-connectors-row-head {
      display: none;
    }
  }

  .plugin-source-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
  }
  .plugin-source-list li {
    line-height: 1.55;
  }
  .plugin-source-list a {
    color: var(--color-forest);
    border-bottom: 1px solid var(--color-forest-soft);
  }
  .plugin-source-note {
    margin-top: var(--spacing-md);
    padding: var(--spacing-sm);
    background: var(--color-clay-dim);
    border-left: 3px solid var(--color-clay);
    border-radius: 0 6px 6px 0;
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.55;
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--color-code-bg);
    padding: 1px 7px;
    border-radius: 4px;
    border: 1px solid var(--color-code-border);
    color: var(--color-ink);
  }
</style>
