---
import SubPage from '../../layouts/SubPage.astro';
import marketplace from '../../../.claude-plugin/marketplace.json';
import {
  PLUGIN_CATEGORIES,
  PLUGIN_CATEGORY_LABELS,
  PLUGIN_CATEGORY_ORDER,
} from '../../lib/sidebar-data';

interface PluginEntry {
  name: string;
  displayName?: string;
  description?: string;
  author?: { name?: string };
  source?: string | { source?: string; url?: string };
  category?: string;
  version?: string;
}

const plugins = (marketplace.plugins ?? []) as PluginEntry[];

// Group: pace router, Anthropic first-party, partner-built (local), external
function classify(p: PluginEntry): 'router' | 'first-party' | 'partner' | 'external' {
  if (p.name === 'pace') return 'router';
  const src = p.source;
  if (typeof src === 'string') {
    if (src.startsWith('./plugins/partner-built/')) return 'partner';
    return 'first-party';
  }
  return 'external';
}

const groups = {
  router: plugins.filter((p) => classify(p) === 'router'),
  'first-party': plugins.filter((p) => classify(p) === 'first-party'),
  partner: plugins.filter((p) => classify(p) === 'partner'),
  external: plugins.filter((p) => classify(p) === 'external'),
};

const total = 50;

const groupLabels: Record<string, { title: string; lede: string }> = {
  router: {
    title: 'Pace router',
    lede: "Your team's company-specific commands.",
  },
  'first-party': {
    title: 'First-party',
    lede: 'Core plugins bundled with the Pace marketplace.',
  },
  partner: {
    title: 'Partner-built',
    lede: 'Vendor-authored plugins distributed in this marketplace.',
  },
  external: {
    title: 'External (referenced by git URL)',
    lede: 'Third-party plugins fetched from upstream repos at install time. Not copied into this repo.',
  },
};

function authorName(p: PluginEntry): string {
  return p.author?.name ?? '(none)';
}

function sourceText(p: PluginEntry): string {
  if (typeof p.source === 'string') return p.source;
  if (p.source && typeof p.source === 'object') return p.source.url ?? '(external)';
  return '(none)';
}

function detailHref(p: PluginEntry): string | null {
  // We generate detail pages for local in-repo plugins (./plugins/...).
  // External plugins (object source) link directly to their upstream.
  if (typeof p.source === 'string' && p.source.startsWith('./plugins/')) {
    return `/plugins/${p.name}`;
  }
  if (p.source && typeof p.source === 'object' && p.source.url) {
    return p.source.url;
  }
  return null;
}

function detailIsExternal(p: PluginEntry): boolean {
  return p.source != null && typeof p.source === 'object';
}

// Build sidebar groups: category -> [plugin names] for local plugins only
// (the sidebar links to detail pages, which only exist for in-repo plugins).
const sidebarItems: Record<string, { slug: string; displayName: string }[]> = {};
for (const cat of PLUGIN_CATEGORY_ORDER) sidebarItems[cat] = [];
for (const p of plugins) {
  if (!detailHref(p)?.startsWith('/plugins/')) continue;
  const cat = PLUGIN_CATEGORIES[p.name] ?? 'specialized';
  sidebarItems[cat].push({
    slug: p.name,
    displayName: p.displayName ?? p.name,
  });
}
for (const cat of PLUGIN_CATEGORY_ORDER) {
  sidebarItems[cat].sort((a, b) => a.slug.localeCompare(b.slug));
}
---

<SubPage
  title="Plugins · Pace"
  description="Browse Pace's full catalog: 50+ Claude Code plugins covering sales, marketing, engineering, finance, legal, ops, HR, product, customer support, and more. Install only the plugins your team uses."
  activeNav="plugins"
  canonicalPath="/plugins"
  sidebarLabel="Plugins"
>
  <Fragment slot="sidebar">
    {PLUGIN_CATEGORY_ORDER.map((cat) => (
      sidebarItems[cat].length > 0 && (
        <div class="subpage-sidebar-group">
          <span class="subpage-sidebar-group-title">{PLUGIN_CATEGORY_LABELS[cat]}</span>
          <ul class="subpage-sidebar-list">
            {sidebarItems[cat].map((item) => (
              <li><a href={`/plugins/${item.slug}`}>{item.slug}</a></li>
            ))}
          </ul>
        </div>
      )
    ))}
    <div class="subpage-sidebar-group">
      <span class="subpage-sidebar-group-title">All plugins</span>
      <ul class="subpage-sidebar-list">
        <li><a href="/plugins" aria-current="page">Catalog (this page)</a></li>
      </ul>
    </div>
  </Fragment>

  <article class="plugins-page">
    <header class="plugins-header">
      <span class="plugins-eyebrow">Marketplace</span>
      <h1>Plugins</h1>
      <p class="plugins-lede">
        Pace bundles <strong>{total} plugins</strong> across four origins: the Pace router (your team's commands), first-party plugins, partner-built plugins, and external plugins referenced from upstream repos.
      </p>
      <div class="plugins-install">
        <code>claude plugin marketplace add GoldenBerry-SO/Pace</code>
      </div>
    </header>

    {(['router', 'first-party', 'partner', 'external'] as const).map((groupKey) => (
      <section class="plugins-group">
        <h2>{groupLabels[groupKey].title}</h2>
        <p class="plugins-group-lede">{groupLabels[groupKey].lede}</p>

        <div class="plugins-table" role="table">
          <div class="plugins-row plugins-row-head" role="row">
            <span role="columnheader">Plugin</span>
            <span role="columnheader">Description</span>
            <span role="columnheader">Author</span>
          </div>
          {groups[groupKey].map((p) => {
            const href = detailHref(p);
            const external = detailIsExternal(p);
            return (
              <div class="plugins-row" role="row">
                <span class="plugins-name" role="cell">
                  {href ? (
                    <a
                      href={href}
                      class="plugins-name-link"
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener' : undefined}
                    >
                      <code>{p.name}</code>
                      {external && <span class="plugins-name-ext" aria-label="External link"> &nearr;</span>}
                    </a>
                  ) : (
                    <code>{p.name}</code>
                  )}
                  {p.displayName && p.displayName !== p.name && (
                    <span class="plugins-displayname">{p.displayName}</span>
                  )}
                </span>
                <span class="plugins-desc" role="cell">{p.description ?? '(none)'}</span>
                <span class="plugins-author" role="cell">{authorName(p)}</span>
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <section class="plugins-howto">
      <h2>Install a plugin</h2>
      <pre><code>claude plugin marketplace add GoldenBerry-SO/Pace
claude plugin install &lt;name&gt;@pace</code></pre>
      <p>
        Replace <code>&lt;name&gt;</code> with any value in the Plugin column. The <code>pace-tools</code> CLI (<code>npx pace-tools install &lt;name&gt;</code>) wraps this for multi-plugin installs. For frontend design, install <a href="https://impeccable.style">impeccable</a> alongside.
      </p>
    </section>
  </article>
</SubPage>

<style>
  .plugins-page {
    max-width: 100%;
  }
  .plugins-header {
    margin-bottom: var(--spacing-2xl);
    border-bottom: 1px solid var(--color-mist);
    padding-bottom: var(--spacing-lg);
  }
  .plugins-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-forest);
    margin-bottom: var(--spacing-sm);
    display: inline-flex;
    align-items: center;
    gap: 16px;
  }
  .plugins-header h1 {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    letter-spacing: -0.03em;
    margin-bottom: var(--spacing-md);
  }
  .plugins-lede {
    font-size: var(--fs-md);
    color: var(--color-charcoal);
    line-height: 1.55;
    max-width: 64ch;
    margin-bottom: var(--spacing-md);
  }
  .plugins-install code {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    padding: 8px 14px;
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 6px;
    display: inline-block;
    color: var(--color-ink);
  }
  .plugins-group {
    margin-bottom: var(--spacing-2xl);
  }
  .plugins-group h2 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--spacing-xs);
  }
  .plugins-group-lede {
    font-size: var(--fs-sm);
    color: var(--color-ash);
    margin-bottom: var(--spacing-md);
  }
  .plugins-table {
    border: 1px solid var(--color-mist);
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-paper-elev);
  }
  .plugins-row {
    display: grid;
    grid-template-columns: 1.3fr 3fr 0.9fr;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
    border-bottom: 1px solid var(--color-mist);
    align-items: start;
    font-size: var(--fs-sm);
  }
  .plugins-row:last-child {
    border-bottom: 0;
  }
  .plugins-row-head {
    background: var(--color-paper);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ash);
    font-weight: 600;
  }
  .plugins-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .plugins-name code {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--color-forest);
    font-weight: 500;
  }
  .plugins-name-link {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out-quart);
  }
  .plugins-name-link:hover {
    border-color: var(--color-forest-soft);
  }
  .plugins-name-ext {
    font-size: 0.7rem;
    color: var(--color-ash);
  }
  .plugins-displayname {
    font-size: var(--fs-xs);
    color: var(--color-ash);
  }
  .plugins-desc {
    color: var(--color-charcoal);
    line-height: 1.5;
  }
  .plugins-author {
    color: var(--color-ash);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .plugins-howto {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--color-mist);
  }
  .plugins-howto h2 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--spacing-md);
  }
  .plugins-howto pre {
    background: var(--color-code-bg);
    border: 1px solid var(--color-code-border);
    padding: var(--spacing-md);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    overflow-x: auto;
    margin-bottom: var(--spacing-md);
  }
  .plugins-howto p {
    font-size: var(--fs-base);
    color: var(--color-charcoal);
    line-height: 1.55;
  }
  @media (max-width: 720px) {
    .plugins-row {
      grid-template-columns: 1fr;
      gap: var(--spacing-xs);
    }
    .plugins-row-head {
      display: none;
    }
  }
</style>
