<style>
  .fe-page {
    max-width: var(--width-max);
    margin: 0 auto;
    padding: 0;
  }
  .fe-hero {
    padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-2xl);
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }
  .fe-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ash);
    padding: 5px 10px;
    border: 1px solid var(--color-mist);
    border-radius: 4px;
    background: var(--color-paper-elev);
    margin-bottom: var(--spacing-md);
  }
  .fe-eyebrow::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: currentColor;
  }
  .fe-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.4vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    margin-bottom: var(--spacing-lg);
    max-width: 20ch;
    margin-left: auto;
    margin-right: auto;
  }
  .fe-lede {
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.65;
    color: var(--color-charcoal);
    margin-bottom: var(--spacing-lg);
    max-width: 64ch;
    margin-left: auto;
    margin-right: auto;
  }
  .fe-hero-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-md);
  }
  .fe-hero-quiet {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ash);
  }
  .fe-hero-quiet a {
    color: var(--color-forest);
    border-bottom: 1px solid var(--color-forest-soft);
  }

  .fe-section {
    max-width: 920px;
    margin: 0 auto;
    padding: var(--spacing-2xl) var(--spacing-lg);
    border-top: 1px solid var(--color-mist);
  }
  .fe-section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-forest);
    padding: 5px 10px;
    border: 1px solid var(--color-forest-soft);
    border-radius: 4px;
    background: var(--color-forest-dim);
    margin-bottom: var(--spacing-md);
  }
  .fe-section-eyebrow::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: currentColor;
  }
  .fe-section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    margin-bottom: var(--spacing-md);
    max-width: 24ch;
  }
  .fe-section-lede {
    font-size: var(--fs-md);
    line-height: 1.65;
    color: var(--color-charcoal);
    max-width: 64ch;
    margin-bottom: var(--spacing-md);
  }
  .fe-section-foot {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-md);
    border-top: 1px dashed var(--color-mist);
    font-size: var(--fs-sm);
    color: var(--color-ash);
    max-width: 64ch;
  }
  .fe-section-foot a {
    color: var(--color-forest);
  }

  /* The flow */
  .fe-flow {
    list-style: none;
    padding: 0;
    margin: var(--spacing-xl) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    counter-reset: step;
  }
  .fe-step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 18px;
    align-items: start;
    padding: var(--spacing-md) var(--spacing-md) var(--spacing-md) 0;
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 12px;
    padding-left: 18px;
  }
  .fe-step-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-forest);
    color: var(--color-paper);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 600;
    flex-shrink: 0;
  }
  .fe-step-body h3 {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    margin: 0 0 6px;
    line-height: 1.2;
  }
  .fe-step-body h3 code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-forest);
    background: transparent;
    padding: 0;
    border: 0;
  }
  .fe-step-body p {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.55;
    margin-bottom: 8px;
  }
  .fe-step-say {
    margin-top: 8px;
    padding: 8px 12px;
    background: var(--color-paper);
    border-left: 2px solid var(--color-forest);
    border-radius: 0 4px 4px 0;
  }
  .fe-step-say em {
    font-style: italic;
    color: var(--color-ink);
  }

  /* Cluster grid */
  .fe-cluster-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
    margin-top: var(--spacing-xl);
  }
  .fe-cluster {
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 12px;
    padding: var(--spacing-md) var(--spacing-lg);
  }
  .fe-cluster h3 {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    margin: 0 0 var(--spacing-sm);
    color: var(--color-ink);
  }
  .fe-cluster ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fe-cluster li {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.5;
  }
  .fe-cluster code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-forest);
    background: var(--color-forest-dim);
    padding: 1px 6px;
    border-radius: 3px;
    border: 0;
  }

  /* CTA slab, dark */
  .fe-section-cta {
    position: relative;
    margin: var(--spacing-2xl) auto 0;
    padding: 0;
    border-top: 0;
    background: var(--color-paper);
    border-radius: 20px;
    overflow: hidden;
    max-width: var(--width-max);
  }
  .fe-section-cta-glow {
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 80%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(45% 35% at 75% 50%, oklch(48% 0.10 32 / 0.45) 0%, transparent 75%),
      radial-gradient(40% 30% at 22% 55%, oklch(40% 0.08 145 / 0.5) 0%, transparent 78%);
    filter: blur(60px);
  }
  .fe-section-cta-inner {
    position: relative;
    z-index: 1;
    max-width: 620px;
    margin: 0 auto;
    padding: var(--spacing-2xl) var(--spacing-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .fe-section-cta-mark {
    width: 84px;
    height: 56px;
    color: var(--color-ink);
  }
  .fe-section-cta-mark svg {
    width: 100%;
    height: 100%;
  }
  .fe-section-cta h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    max-width: 18ch;
    margin: 0;
  }
  .fe-section-cta p {
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--color-charcoal);
    max-width: 50ch;
    margin: 0;
  }
  .fe-section-cta-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  @media (max-width: 720px) {
    .fe-step {
      grid-template-columns: 1fr;
      padding-left: var(--spacing-md);
    }
    .fe-cluster-grid {
      grid-template-columns: 1fr;
    }
    .fe-section-cta {
      border-radius: 0;
    }
  }
</style>
