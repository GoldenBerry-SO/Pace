---
import SubPage from '../../../layouts/SubPage.astro';
import type { TeamGuide } from '../../../lib/team-guides';
import { DOCS_SIDEBAR } from '../../../lib/sidebar-data';

export async function getStaticPaths() {
  const { TEAM_GUIDES } = await import('../../../lib/team-guides');
  return TEAM_GUIDES.map((team) => ({
    params: { team: team.slug },
    props: { team },
  }));
}

interface Props {
  team: TeamGuide;
}

const { team } = Astro.props as Props;
const currentPath = `/docs/teams/${team.slug}`;

const COWORK_DEEPLINK_BASE = 'https://claude.ai/desktop/customize/plugins/new?marketplace=GoldenBerry-SO/Pace';
const pluginSlugs = team.plugins.map((p) => p.slug);
const cliInstallCmd = pluginSlugs.length > 0
  ? `npx pace-tools install ${pluginSlugs.join(' ')}`
  : '';
---

<SubPage
  title={`${team.name} · Pace`}
  description={team.tagline}
  activeNav="docs"
  canonicalPath={currentPath}
  sidebarLabel="Docs"
>
  <Fragment slot="sidebar">
    {DOCS_SIDEBAR.map((group) => (
      <div class="subpage-sidebar-group">
        <span class="subpage-sidebar-group-title">{group.title}</span>
        <ul class="subpage-sidebar-list">
          {group.items.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.href === currentPath ? 'page' : undefined}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </Fragment>

  <article class="team-page">
    <header class="team-header">
      <div class="team-breadcrumb">
        <a href="/docs/teams">All teams</a>
        <span>/</span>
        <span>{team.name}</span>
      </div>
      <h1>{team.name}</h1>
      <p class="team-tagline">{team.tagline}</p>
      <p class="team-intro">{team.intro}</p>
    </header>

    {team.redirect && (
      <section class="team-redirect">
        <a
          class="team-redirect-card"
          href={team.redirect.url}
          target="_blank"
          rel="noopener"
        >
          <div class="team-redirect-card-main">
            <span class="team-redirect-card-host">{new URL(team.redirect.url).hostname}</span>
            <span class="team-redirect-card-cta">{team.redirect.cta}</span>
          </div>
          <svg
            class="team-redirect-card-arrow"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17L17 7" />
            <path d="M8 7h9v9" />
          </svg>
        </a>
        <p class="team-redirect-footnote">
          {team.redirect.reason}
        </p>
        <p class="team-redirect-footnote">
          Pace still includes Anthropic's <a href="/plugins/design"><code>design</code></a> plugin in the catalog if you want UX research, accessibility audits, or dev handoff skills alongside impeccable.
        </p>
      </section>
    )}

    {!team.redirect && (
      <>
        <section class="team-section team-install-cta" id="install">
          <h2>Install for {team.name}</h2>
          <p class="team-section-lede">The full {team.name.toLowerCase()} starter set is <strong>{pluginSlugs.length} plugin{pluginSlugs.length === 1 ? '' : 's'}</strong>. Pick the install path that matches you.</p>

          <div class="team-install-grid">
            <div class="team-install-block">
              <h3>Cowork (no terminal)</h3>
              <p class="team-install-block-lede">Click each link below; Cowork opens and asks you to confirm. Restart Cowork after the last one so connectors register.</p>
              <ol class="team-install-deeplinks">
                {team.plugins.map((p, i) => (
                  <li>
                    <a
                      class="team-install-deeplink"
                      href={`${COWORK_DEEPLINK_BASE}&plugin=${p.slug}`}
                      target="_blank"
                      rel="noopener"
                    >
                      <span class="team-install-deeplink-num">{i + 1}</span>
                      <span class="team-install-deeplink-name">Install <code>{p.slug}</code></span>
                      <span class="team-install-deeplink-arrow" aria-hidden="true">&nearr;</span>
                    </a>
                  </li>
                ))}
              </ol>
              <div class="team-install-callout">
                <strong>After the last install, restart Cowork.</strong> The MCP servers (Slack, HubSpot, etc.) only register cleanly on a fresh app start. Quit the app fully, then reopen it.
              </div>
            </div>

            <div class="team-install-block">
              <h3>Terminal (one command)</h3>
              <p class="team-install-block-lede">If you have <code>claude</code> on your PATH already, this installs the whole set in one go.</p>
              <pre class="team-install-pre"><code>{cliInstallCmd}</code></pre>
              <p class="team-install-aside">
                <code>pace-tools</code> wraps <code>claude plugin install</code>; runs <code>claude plugin marketplace add GoldenBerry-SO/Pace</code> automatically if you haven't registered the marketplace yet.
              </p>
            </div>
          </div>
        </section>

        <section class="team-section" id="plugins">
          <h2>Plugins to install</h2>
          <p class="team-section-lede">Pick from this set for the role. Primary plugins are essential; companions multiply value.</p>
          <ul class="team-plugins-list">
            {team.plugins.map((p) => (
              <li class={`team-plugin team-plugin-${p.role}`}>
                <div class="team-plugin-head">
                  <a class="team-plugin-name" href={`/plugins/${p.slug}`}>{p.slug}</a>
                  <span class={`team-plugin-role team-plugin-role-${p.role}`}>{p.role}</span>
                </div>
                <p class="team-plugin-why">{p.why}</p>
                <code class="team-plugin-install">claude plugin install {p.slug}@pace</code>
              </li>
            ))}
          </ul>
        </section>

        <section class="team-section" id="connectors">
          <h2>Connectors to set up</h2>
          <p class="team-section-lede">Claude prompts to authorize each one the first time a relevant skill fires. You only do this once per project.</p>
          <ul class="team-connectors">
            {team.connectors.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </section>

        <section class="team-section" id="workflows">
          <h2>Workflows</h2>
          <p class="team-section-lede">Common ways teams use these plugins day to day. Each one is a starting point; adapt the prompt to your context.</p>
          <ul class="team-workflows">
            {team.workflows.map((w) => (
              <li class="team-workflow">
                <h3>{w.title}</h3>
                <p>{w.description}</p>
                {w.prompt && <code class="team-workflow-prompt">{w.prompt}</code>}
              </li>
            ))}
          </ul>
        </section>

        {team.triggers && team.triggers.length > 0 && (
          <section class="team-section" id="triggers">
            <h2>Just say it</h2>
            <p class="team-section-lede">
              You don't have to memorize slash commands. After installing, type natural sentences into Claude and the right skill will fire. Each row is a real example.
            </p>
            <ul class="team-triggers">
              {team.triggers.map((t) => (
                <li class="team-trigger">
                  <div class="team-trigger-say">
                    <span class="team-trigger-label">You say</span>
                    <p>{t.say}</p>
                  </div>
                  <div class="team-trigger-arrow" aria-hidden="true">&rarr;</div>
                  <div class="team-trigger-runs">
                    <span class="team-trigger-label">Claude runs</span>
                    <code>{t.runs}</code>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="team-section" id="tips">
          <h2>Tips &amp; tricks</h2>
          <p class="team-section-lede">Field-tested patterns from teams that have already shipped a quarter or two on these plugins.</p>
          <ul class="team-tips">
            {team.tips.map((t) => (
              <li class="team-tip">
                <h3>{t.title}</h3>
                <p>{t.body}</p>
              </li>
            ))}
          </ul>
        </section>
      </>
    )}

    {team.seeAlso.length > 0 && (
      <section class="team-section team-see-also" id="see-also">
        <h2>See also</h2>
        <ul class="team-see-also-list">
          {team.seeAlso.map((s) => (
            <li>
              <a href={`/docs/teams/${s.slug}`}>
                <strong>{s.label}</strong>
                <span>{s.why}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</SubPage>

<style>
  .team-page {
    max-width: 760px;
  }
  .team-header {
    margin-bottom: var(--spacing-2xl);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-mist);
  }
  .team-breadcrumb {
    display: flex;
    gap: var(--spacing-xs);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-ash);
    margin-bottom: var(--spacing-md);
  }
  .team-breadcrumb a {
    color: var(--color-forest);
    border-bottom: 1px solid var(--color-forest-soft);
  }
  .team-header h1 {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    letter-spacing: -0.03em;
    margin-bottom: var(--spacing-sm);
  }
  .team-tagline {
    font-size: var(--fs-md);
    color: var(--color-charcoal);
    line-height: 1.5;
    margin-bottom: var(--spacing-md);
  }
  .team-intro {
    font-size: var(--fs-base);
    color: var(--color-ink);
    line-height: 1.65;
  }
  .team-section {
    margin-bottom: var(--spacing-2xl);
    scroll-margin-top: 96px;
  }
  .team-section h2 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    letter-spacing: -0.02em;
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-xs);
    border-bottom: 1px solid var(--color-mist);
  }
  .team-section-lede {
    font-size: var(--fs-base);
    color: var(--color-charcoal);
    line-height: 1.55;
    margin-bottom: var(--spacing-md);
  }

  /* Plugins list */
  .team-plugins-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--spacing-sm);
  }
  .team-plugin {
    padding: var(--spacing-md);
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 8px;
  }
  .team-plugin-primary {
    border-left: 3px solid var(--color-forest);
  }
  .team-plugin-companion {
    border-left: 3px solid var(--color-clay);
  }
  .team-plugin-head {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }
  .team-plugin-name {
    font-family: var(--font-mono);
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--color-forest);
    border-bottom: 1px solid var(--color-forest-soft);
  }
  .team-plugin-role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .team-plugin-role-primary {
    background: var(--color-forest-dim);
    color: var(--color-forest);
  }
  .team-plugin-role-companion {
    background: var(--color-clay-dim);
    color: var(--color-clay-hover);
  }
  .team-plugin-why {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.55;
    margin-bottom: var(--spacing-sm);
  }
  .team-plugin-install {
    display: block;
    padding: 8px 12px;
    background: oklch(18% 0.015 150);
    color: oklch(92% 0.005 150);
    border-radius: 4px;
    border: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    overflow-x: auto;
  }

  /* Connectors */
  .team-connectors {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }
  .team-connectors li {
    padding: 6px 12px;
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 999px;
    font-size: var(--fs-xs);
    color: var(--color-charcoal);
    font-family: var(--font-mono);
  }

  /* Workflows */
  .team-workflows {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--spacing-md);
  }
  .team-workflow {
    padding: var(--spacing-md);
    border: 1px solid var(--color-mist);
    border-radius: 8px;
    background: var(--color-paper-elev);
  }
  .team-workflow h3 {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: var(--spacing-xs);
  }
  .team-workflow p {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.55;
    margin-bottom: var(--spacing-sm);
  }
  .team-workflow-prompt {
    display: block;
    padding: 8px 12px;
    background: oklch(18% 0.015 150);
    color: oklch(92% 0.005 150);
    border-radius: 4px;
    border: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    overflow-x: auto;
  }

  /* Tips */
  .team-tips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--spacing-md);
  }
  /* Install CTA */
  .team-install-cta {
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 10px;
    padding: var(--spacing-lg) var(--spacing-xl);
  }
  .team-install-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-top: var(--spacing-md);
  }
  @media (max-width: 720px) {
    .team-install-grid {
      grid-template-columns: 1fr;
    }
  }
  .team-install-block h3 {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: var(--spacing-xs);
  }
  .team-install-block-lede {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.55;
    margin-bottom: var(--spacing-sm);
  }
  .team-install-deeplinks {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-sm) 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .team-install-deeplink {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 8px 12px;
    background: var(--color-paper);
    border: 1px solid var(--color-mist);
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-ink);
    font-size: var(--fs-sm);
    transition: border-color var(--duration-fast) var(--ease-out-quart), background var(--duration-fast) var(--ease-out-quart);
  }
  .team-install-deeplink:hover {
    border-color: var(--color-forest);
    background: var(--color-forest-dim);
  }
  .team-install-deeplink-num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-forest);
    font-weight: 600;
    text-align: center;
  }
  .team-install-deeplink-name code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    color: var(--color-forest);
    background: transparent;
    padding: 0;
    border: 0;
    font-weight: 600;
  }
  .team-install-deeplink-arrow {
    color: var(--color-ash);
    font-size: var(--fs-base);
  }
  .team-install-callout {
    background: var(--color-clay-dim);
    border-left: 3px solid var(--color-clay);
    padding: 10px 14px;
    border-radius: 0 6px 6px 0;
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.55;
  }
  .team-install-callout strong {
    color: var(--color-clay-hover);
  }
  .team-install-pre {
    background: oklch(18% 0.015 150);
    color: oklch(92% 0.005 150);
    padding: var(--spacing-md);
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    overflow-x: auto;
    margin: 0 0 var(--spacing-sm) 0;
    line-height: 1.5;
  }
  .team-install-pre code {
    background: transparent;
    border: 0;
    padding: 0;
    color: inherit;
    word-break: break-all;
  }
  .team-install-aside {
    font-size: var(--fs-xs);
    color: var(--color-ash);
    line-height: 1.55;
  }
  .team-install-aside code {
    font-family: var(--font-mono);
    background: var(--color-code-bg);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--color-code-border);
    font-size: 0.95em;
    color: var(--color-ink);
  }

  /* Triggers cheatsheet */
  .team-triggers {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }
  .team-trigger {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--spacing-md);
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 8px;
  }
  @media (max-width: 720px) {
    .team-trigger {
      grid-template-columns: 1fr;
      gap: var(--spacing-xs);
    }
    .team-trigger-arrow {
      display: none;
    }
  }
  .team-trigger-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ash);
    display: block;
    margin-bottom: 2px;
  }
  .team-trigger-say p {
    font-size: var(--fs-sm);
    color: var(--color-ink);
    line-height: 1.5;
    font-style: italic;
  }
  .team-trigger-arrow {
    color: var(--color-forest);
    font-size: var(--fs-lg);
  }
  .team-trigger-runs code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--color-forest);
    background: var(--color-forest-dim);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--color-forest-soft);
  }

  .team-tip {
    padding-left: var(--spacing-md);
    border-left: 2px solid var(--color-mist);
  }
  .team-tip h3 {
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    margin-bottom: 4px;
  }
  .team-tip p {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.55;
  }

  /* See also */
  .team-see-also-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--spacing-sm);
  }
  .team-see-also-list a {
    display: block;
    padding: var(--spacing-md);
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-radius: 8px;
    transition: border-color var(--duration-fast) var(--ease-out-quart);
    text-decoration: none;
    color: inherit;
  }
  .team-see-also-list a:hover {
    border-color: var(--color-forest-soft);
  }
  .team-see-also-list strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 4px;
  }
  .team-see-also-list span {
    font-size: var(--fs-sm);
    color: var(--color-charcoal);
    line-height: 1.5;
  }

  /* Redirect variant (design team -> impeccable) */
  .team-redirect {
    margin-bottom: var(--spacing-2xl);
  }
  .team-redirect-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: var(--spacing-md) var(--spacing-lg);
    background: var(--color-paper-elev);
    border: 1px solid var(--color-mist);
    border-left: 3px solid var(--color-forest);
    border-radius: 0 10px 10px 0;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color var(--duration-base) var(--ease-out-quart),
      background var(--duration-base) var(--ease-out-quart),
      transform var(--duration-base) var(--ease-out-quart);
  }
  .team-redirect-card:hover {
    border-color: var(--color-forest-soft);
    border-left-color: var(--color-forest);
    background: var(--color-forest-dim);
    transform: translateX(2px);
  }
  .team-redirect-card-main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .team-redirect-card-host {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ash);
  }
  .team-redirect-card-cta {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .team-redirect-card-arrow {
    color: var(--color-forest);
    flex-shrink: 0;
    transition: transform var(--duration-base) var(--ease-out-quart);
  }
  .team-redirect-card:hover .team-redirect-card-arrow {
    transform: translate(2px, -2px);
  }
  .team-redirect-footnote {
    margin-top: var(--spacing-md);
    font-size: var(--fs-base);
    color: var(--color-charcoal);
    line-height: 1.65;
    max-width: 64ch;
  }
  .team-redirect-footnote a {
    color: var(--color-forest);
    border-bottom: 1px solid var(--color-forest-soft);
    text-decoration: none;
  }
  .team-redirect-footnote a:hover {
    border-color: var(--color-forest);
  }

  code {
