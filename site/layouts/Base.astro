---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/main.css';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'home' | 'docs' | 'tutorials' | 'cases';
  canonicalPath?: string;
  noIndex?: boolean;
  hideHeader?: boolean;
  hideFooter?: boolean;
  mainClass?: string;
}

const {
  title,
  description = 'Company-wide skills for AI coding agents. One router, many commands across engineering, product, ops, marketing.',
  activeNav,
  canonicalPath,
  noIndex = false,
  hideHeader = false,
  hideFooter = false,
  mainClass,
} = Astro.props;

const canonical = canonicalPath
  ? `https://pace.tools${canonicalPath}`
  : undefined;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#f3f1e9">
  {noIndex && <meta name="robots" content="noindex">}
  {canonical && <link rel="canonical" href={canonical}>}
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {canonical && <meta property="og:url" content={canonical}>}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  {!hideHeader && <Header activeNav={activeNav} />}
  <main id="main" class={mainClass}>
    <slot />
  </main>
  {!hideFooter && <Footer />}
</body>
</html>
