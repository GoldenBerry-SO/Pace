{
  "name": "pace-tools",
  "version": "0.3.0",
  "author": "Chris Jimenez",
  "description": "Pace: AI specialists for every team at your company. A Claude Code plugin marketplace covering sales, marketing, engineering, finance, ops, product, legal, HR, and more.",
  "keywords": [
    "pace",
    "claude-code",
    "claude-code-plugins",
    "claude-code-marketplace",
    "ai-agents",
    "ai-skills",
    "mcp",
    "cursor",
    "gemini",
    "codex",
    "engineering",
    "sales",
    "marketing"
  ],
  "license": "Apache-2.0",
  "homepage": "https://pace.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoldenBerry-SO/Pace.git"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "pace": "cli/bin/cli.js"
  },
  "files": [
    "cli/",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build:skills": "bun run scripts/build.js",
    "build:site": "npx astro build",
    "build:marketplace": "mkdir -p site/public/.claude-plugin && cp .claude-plugin/marketplace.json site/public/.claude-plugin/marketplace.json",
    "build": "bun run build:skills && bun run build:marketplace && bun run build:site",
    "clean": "rm -rf dist build",
    "rebuild": "bun run clean && bun run build",
    "dev": "npx astro dev",
    "preview": "bun run build && npx astro preview",
    "deploy": "bun run build && wrangler pages deploy build/",
    "audit": "bun audit --audit-level=moderate",
    "prepack": "cp README.md README.repo.md && cp README.npm.md README.md",
    "postpack": "cp README.repo.md README.md && rm README.repo.md",
    "release:skill": "node scripts/release.mjs skill",
    "release:cli": "node scripts/release.mjs cli"
  },
  "dependencies": {
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "archiver": "^7.0.1",
    "astro": "^6.2.1",
    "wrangler": "^4.85.0"
  }
}
